{
  "name": "ready-edge-extension",
  "private": true,
  "version": "0.1.1",
  "description": "Turn Edge Favorites into a reading library with progress tracking, highlights, notes, and reading insights.",
  "license": "MIT",
  "author": "Mariano Viola",
  "homepage": "https://marianoviola.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/marianoviola/ready.git"
  },
  "bugs": {
    "url": "https://marianoviola.com/contact/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-extension.mjs",
    "package": "npm run build && node scripts/package-extension.mjs",
    "test:distribution": "node --test tests/distribution.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:edge": "npm run build && READY_E2E_CHANNEL=msedge playwright test",
    "store:assets": "node scripts/store-assets.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldts": "^7.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
